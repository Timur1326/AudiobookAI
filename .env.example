# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic Claude API (used for quote splitting, character extraction,
# dialogue attribution, scene detection, voice assignment)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs TTS API (used for voice synthesis and voice listing)
ELEVENLABS_API_KEY=...

# ── Optional ──────────────────────────────────────────────────────────────────

# Freesound API key for ambient sound search and download
# Register at https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# JWT secret key — change this in production
SECRET_KEY=in-production

